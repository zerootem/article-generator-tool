{
  "name": "article-generator-tool",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-public-css.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/sync-public-css.mjs",
    "build": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json && vite build",
    "prebuild:site": "node scripts/sync-public-css.mjs",
    "build:site": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "jose": "^6.2.17"
  }
}
